# Port the server listens on
PORT=4000

# Contact email for VAPID (used in push headers)
VAPID_CONTACT=mailto:you@example.com

# Optional: provide your own VAPID keys (else auto-generated on first run, saved to data/vapid.json).
# Generate a pair with:  npm run keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# How often the overdue sweep runs (cron). Default every 15 minutes.
CRON=*/15 * * * *

# Don't re-nudge the same overdue chore more often than this (hours).
RENOTIFY_HOURS=20
