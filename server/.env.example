# ─── Networking ──────────────────────────────────────────────────────────────
# Host port you'll reach the server on (http://<host>:PUSH_PORT).
PUSH_PORT=4000
# Port the app listens on inside the container (rarely needs changing).
CONTAINER_PORT=4000

# ─── Data location ───────────────────────────────────────────────────────────
# Where the data folder (subscriptions + VAPID keypair) is stored ON THE HOST.
# Point this at your NAS so it survives redeploys. Examples:
#   DATA_PATH=/volume1/docker/lastdone/data   # Synology
#   DATA_PATH=/mnt/nas/lastdone/data          # generic Linux NFS/CIFS mount
#   DATA_PATH=./data                          # local folder next to compose (default)
DATA_PATH=./data

# Container name (handy when running several stacks).
CONTAINER_NAME=lastdone-push

# Optional: deploy a prebuilt image instead of building (see compose comments).
# IMAGE=lastdone-push:latest

# ─── VAPID (Web Push identity) ───────────────────────────────────────────────
# Contact email put in push headers.
VAPID_CONTACT=mailto:you@example.com
# Optional: bring your own keys. If blank, a pair is generated on first run and
# saved to <DATA_PATH>/vapid.json. KEEP THESE STABLE — regenerating them
# invalidates every existing browser subscription. Generate a pair with:
#   npm run keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# ─── Behaviour ───────────────────────────────────────────────────────────────
# How often the overdue sweep runs (cron). Default every 15 minutes.
CRON=*/15 * * * *
# Don't re-nudge the same overdue chore more often than this (hours).
RENOTIFY_HOURS=20

# ─── Remote NAS over NFS (only if using the named-volume block in compose) ────
# NAS_ADDR=192.168.1.10
# NAS_EXPORT_PATH=/volume1/docker/lastdone/data
